#!/usr/bin/env python3

import argparse
import sys

from rosidl_typesupport_xcdr_cpython import generate_cpython


def main(argv=sys.argv[1:]):
    parser = argparse.ArgumentParser(
        description='Generate XCDR CPython typesupport code.',
        formatter_class=argparse.ArgumentDefaultsHelpFormatter)
    parser.add_argument(
        '--generator-arguments-file',
        required=True,
        help='The location of the file containing the generator arguments')
    args = parser.parse_args(argv)

    generate_cpython(args.generator_arguments_file)


if __name__ == '__main__':
    sys.exit(main())
