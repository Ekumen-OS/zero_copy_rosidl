<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Shared-memory-only transport profile for constrained_pubsub_benchmark.

  Disables UDP entirely (builtin transports off, custom SHM descriptor
  only) and forces data sharing off, so traffic goes through the SHM
  transport with ordinary copies.  Sized for the 40 MB payload step:
  48 MB max message, 64 MB segment.  Requires roughly 64 MB of free
  /dev/shm per participant.

  Use with RMW_FASTRTPS_USE_QOS_FROM_XML=1 so rmw_fastrtps honors the
  endpoint data_sharing QoS instead of its middleware defaults.
-->
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <profiles>
    <transport_descriptors>
      <transport_descriptor>
        <transport_id>benchmark_shm_transport</transport_id>
        <type>SHM</type>
        <segment_size>67108864</segment_size>
        <maxMessageSize>50331648</maxMessageSize>
        <port_queue_capacity>512</port_queue_capacity>
        <healthy_check_timeout_ms>1000</healthy_check_timeout_ms>
      </transport_descriptor>
    </transport_descriptors>

    <participant profile_name="benchmark_shm_participant" is_default_profile="true">
      <rtps>
        <useBuiltinTransports>false</useBuiltinTransports>
        <userTransports>
          <transport_id>benchmark_shm_transport</transport_id>
        </userTransports>
      </rtps>
    </participant>

    <data_writer profile_name="benchmark_shm_writer" is_default_profile="true">
      <qos>
        <data_sharing>
          <kind>OFF</kind>
        </data_sharing>
      </qos>
    </data_writer>

    <data_reader profile_name="benchmark_shm_reader" is_default_profile="true">
      <qos>
        <data_sharing>
          <kind>OFF</kind>
        </data_sharing>
      </qos>
    </data_reader>
  </profiles>
</dds>
